[sub_resource type="Resource" id="Resource_pfq23"]
script = ExtResource("5_2ksbr")
entry_name = "meet_bolo"
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_aw2o8")])
id = 1

[sub_resource type="Resource" id="Resource_mfgfi"]
script = ExtResource("2_3yrdr")
target_id = 3

[sub_resource type="Resource" id="Resource_b64xt"]
script = ExtResource("6_lha2g")
text = "There is a lamp at the foot of the stairs. A woman sits beside it, sorting fragments into a row. She moves one aside to make room for your boots."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_mfgfi")])
id = 2
graph_position = Vector2(340, 0)

[sub_resource type="Resource" id="Resource_8wsl0"]
script = ExtResource("2_3yrdr")
target_id = 4

[sub_resource type="Resource" id="Resource_1ktjg"]
script = ExtResource("7_thx62")
talker = "Unknown Woman"

[sub_resource type="Resource" id="Resource_5mrbl"]
script = ExtResource("6_lha2g")
text = "Careful. That bit with the scratch goes next to the hinge. I've been looking for it since before your surveyors arrived."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_8wsl0")])
id = 3
graph_position = Vector2(680, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_1ktjg")])

[sub_resource type="Resource" id="Resource_0a8ko"]
script = ExtResource("2_3yrdr")
target_id = 5

[sub_resource type="Resource" id="Resource_nbghq"]
script = ExtResource("7_thx62")
talker = "Unknown Woman"

[sub_resource type="Resource" id="Resource_a1qbc"]
script = ExtResource("6_lha2g")
text = "You're the Facilitator. Your survey crews cut down my fig tree. I planted it the night your ship came down."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_0a8ko")])
id = 4
graph_position = Vector2(1020, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_nbghq")])

[sub_resource type="Resource" id="Resource_nnvif"]
script = ExtResource("2_3yrdr")
target_id = 6

[sub_resource type="Resource" id="Resource_ms0ta"]
script = ExtResource("7_thx62")
talker = "Unknown Woman"

[sub_resource type="Resource" id="Resource_nc2l8"]
script = ExtResource("6_lha2g")
text = "I called the tree Bolo. You can call me that."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_nnvif")])
id = 5
graph_position = Vector2(1360, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_ms0ta")])

[sub_resource type="Resource" id="Resource_pavhv"]
script = ExtResource("2_3yrdr")
target_id = 7

[sub_resource type="Resource" id="Resource_6xrva"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_jmr4i"]
script = ExtResource("6_lha2g")
text = "I grew up underground. When the floods came, my people taught a fungus to cut rooms through rock. My family lived in one of those rooms. People still live there."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_pavhv")])
id = 6
graph_position = Vector2(1700, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_6xrva")])

[sub_resource type="Resource" id="Resource_52er6"]
script = ExtResource("2_3yrdr")
target_id = 8

[sub_resource type="Resource" id="Resource_qwjdk"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_kgdx5"]
script = ExtResource("6_lha2g")
text = "I came up when your ship landed. I learned your words from the broadcasts. I wanted to ask what your ship had heard on its way down."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_52er6")])
id = 7
graph_position = Vector2(2040, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_qwjdk")])

[sub_resource type="Resource" id="Resource_rcjbi"]
script = ExtResource("2_3yrdr")
target_id = 9

[sub_resource type="Resource" id="Resource_53od6"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_6t0nn"]
script = ExtResource("6_lha2g")
text = "There is a record in here. I can read parts of it. The pauses are the same as a signal I have been hearing from the Moon."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_rcjbi")])
id = 8
graph_position = Vector2(2380, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_53od6")])

[sub_resource type="Resource" id="Resource_etcmx"]
script = ExtResource("2_3yrdr")
target_id = 10
label = "What do you hear?"

[sub_resource type="Resource" id="Resource_ekl0y"]
script = ExtResource("2_3yrdr")
target_id = 11
label = "Tell me about your tree."

[sub_resource type="Resource" id="Resource_gjm0s"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_ht1dh"]
script = ExtResource("6_lha2g")
text = "I used my own blood to try the equipment down here. I ran the test again years later. My readings should have changed by then. They match right down to the last decimal."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_etcmx"), SubResource("Resource_ekl0y")])
id = 9
graph_position = Vector2(2720, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_gjm0s")])

[sub_resource type="Resource" id="Resource_ffn84"]
script = ExtResource("2_3yrdr")
target_id = 12

[sub_resource type="Resource" id="Resource_hxn4g"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_g11mt"]
script = ExtResource("6_lha2g")
text = "A hum with a gap in it. Always the same gap. That is usually where somebody has left room for an answer."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_ffn84")])
id = 10
graph_position = Vector2(3060, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_hxn4g")])

[sub_resource type="Resource" id="Resource_1g183"]
script = ExtResource("2_3yrdr")
target_id = 12

[sub_resource type="Resource" id="Resource_1conf"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_3ou3y"]
script = ExtResource("6_lha2g")
text = "It shaded the entrance in the afternoon. I used to set my recorder there. The soil is still bare where the roots were."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_1g183")])
id = 11
graph_position = Vector2(3060, 140)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_1conf")])

[sub_resource type="Resource" id="Resource_hkgn1"]
script = ExtResource("2_3yrdr")
target_id = 13

[sub_resource type="Resource" id="Resource_fjvpw"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_b4rm0"]
script = ExtResource("6_lha2g")
text = "I can give you my recordings. In return, I want to see what I-330's receivers pick up before your caretakers clean it. Some of those gaps might have data in them."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_hkgn1")])
id = 12
graph_position = Vector2(3400, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_fjvpw")])

[sub_resource type="Resource" id="Resource_w0lmi"]
script = ExtResource("2_3yrdr")
target_id = 14

[sub_resource type="Resource" id="Resource_827b6"]
script = ExtResource("7_thx62")
talker = "Player"

[sub_resource type="Resource" id="Resource_4i1lt"]
script = ExtResource("6_lha2g")
text = "You'll have access to the signal. Let me know what you find."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_w0lmi")])
id = 13
graph_position = Vector2(3740, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_827b6")])

[sub_resource type="Resource" id="Resource_wce7i"]
script = ExtResource("2_3yrdr")
target_id = 15

[sub_resource type="Resource" id="Resource_a6od5"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_1rto4"]
script = ExtResource("6_lha2g")
text = "Then we can work together. I will start with the Moon."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_wce7i")])
id = 14
graph_position = Vector2(4080, 0)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_a6od5")])

