[sub_resource type="Resource" id="Resource_vd533"]
script = ExtResource("7_thx62")
talker = "Unknown Woman"

[sub_resource type="Resource" id="Resource_wek0n"]
script = ExtResource("6_lha2g")
text = "Call me Bolo. It's the name of a fig tree I planted the night your ship came down."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_bm3ew")])
id = 18
