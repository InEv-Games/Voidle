script = ExtResource("2_3yrdr")
target_id = 23

[sub_resource type="Resource" id="Resource_j5yic"]
script = ExtResource("7_thx62")
talker = "Player"

[sub_resource type="Resource" id="Resource_rx3xp"]
script = ExtResource("6_lha2g")
text = "Come with us. I'll give you access to the ship's raw receiver logs."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_xam0f")])
