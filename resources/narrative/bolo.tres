target_id = 18

[sub_resource type="Resource" id="Resource_7jpli"]
script = ExtResource("6_lha2g")
text = "A woman waits by the Spaceport cargo ramp with a recorder wrapped in a cloth. She keeps one hand on it when the ground crew passes."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_87m7w")])
id = 17
graph_position = Vector2(340, 260)

[sub_resource type="Resource" id="Resource_bm3ew"]
