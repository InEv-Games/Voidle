[sub_resource type="Resource" id="Resource_cpeqg"]
script = ExtResource("2_3yrdr")
target_id = 20

[sub_resource type="Resource" id="Resource_wejcp"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_fseta"]
script = ExtResource("6_lha2g")
text = "My people moved underground when the floods came. I grew up in rooms they carved with fungus. They're still down there. I came up to see what had landed."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_cpeqg")])
id = 19
graph_position = Vector2(1020, 260)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_wejcp")])

[sub_resource type="Resource" id="Resource_ptx8b"]
script = ExtResource("2_3yrdr")
target_id = 21

[sub_resource type="Resource" id="Resource_3pywb"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_lkpf3"]
script = ExtResource("6_lha2g")
text = "I picked up a pulse from a crater on the Moon. The pause matches a recording I've been working on under the fallen stones."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_ptx8b")])
id = 20
graph_position = Vector2(1360, 260)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_3pywb")])

[sub_resource type="Resource" id="Resource_3pftp"]
script = ExtResource("2_3yrdr")
target_id = 22

[sub_resource type="Resource" id="Resource_7sa6g"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_r7wgn"]
script = ExtResource("6_lha2g")
text = "I used my blood to test an instrument in that room. Years later I got the same reading, down to the last decimal. I'd like to try the instrument at the other end."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_3pftp")])
id = 21
graph_position = Vector2(1700, 260)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_7sa6g")])

