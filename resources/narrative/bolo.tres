[sub_resource type="Resource" id="Resource_3ctfc"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_j8ta5"]
script = ExtResource("6_lha2g")
text = "I took all five surveys home. We put them beside the maps we've kept since the floods. Your crews found a road we thought we'd lost. A cart can take it all the way to the surface."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_lr8mf")])
id = 29
graph_position = Vector2(340, 780)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_3ctfc")])

[sub_resource type="Resource" id="Resource_hadj1"]
script = ExtResource("2_3yrdr")
target_id = 31
label = "Tell them they are welcome."

[sub_resource type="Resource" id="Resource_068gq"]
script = ExtResource("2_3yrdr")
target_id = 32
label = "Let's make room first."

[sub_resource type="Resource" id="Resource_88jqe"]
script = ExtResource("7_thx62")
talker = "Bolo"

[sub_resource type="Resource" id="Resource_r2bq6"]
script = ExtResource("6_lha2g")
text = "Every household sent someone to the meeting. By morning, everyone had agreed to move up. They asked me to find out if you'll make room for us."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_hadj1"), SubResource("Resource_068gq")])
id = 30
graph_position = Vector2(680, 780)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_88jqe")])

