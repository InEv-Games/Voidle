talker = "Bolo"

[sub_resource type="Resource" id="Resource_3xlnw"]
script = ExtResource("6_lha2g")
text = "I'll send word. Tell your crews to meet us at the road by the survey camp. The first carts will come up there."
exits = Array[ExtResource("2_3yrdr")]([SubResource("Resource_pum7c")])
id = 31
graph_position = Vector2(1020, 780)
modifiers = Array[ExtResource("4_rupuy")]([SubResource("Resource_qkssn")])

