static func position(point: Vector2) -> Vector2:
	return (point - ORIGIN) * SCALE

static func rim_position(angle_degrees: float) -> Vector2:
	return position(RIM_CENTER + Vector2.from_angle(deg_to_rad(angle_degrees)) * RIM_RADIUS)

static func rim_segment(from_angle: float, to_angle: float) -> PackedVector2Array:
	var points := PackedVector2Array()
	var sweep := fposmod(to_angle - from_angle, 360.0)
	for step in range(13):
		points.append(rim_position(from_angle + sweep * float(step) / 12.0))
	return points
